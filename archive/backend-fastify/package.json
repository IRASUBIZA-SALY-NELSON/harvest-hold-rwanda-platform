{
  "name": "harvest-hold-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "migrate": "tsx --env-file=.env src/migrate.ts",
    "seed": "tsx --env-file=.env src/seed.ts",
    "simulate": "tsx --env-file=.env src/simulate.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "firmware:release": "tsx --env-file=.env src/release-firmware.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/rate-limit": "^11.2.1",
    "bcryptjs": "^3.0.3",
    "fastify": "^5.12.7",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
