# Copy to .env and fill in.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://harvest:harvest@127.0.0.1:5440/harvest
# Public address of this API: used in certificate QR codes and the verify page.
PUBLIC_BASE_URL=http://192.168.0.115:4000
# Long random string. Generate one with: openssl rand -hex 32
SECRET=change-me
CROP_PROFILES_DIR=../crop-profiles

# SMS: "console" prints messages to the log (development). "africastalking" sends real SMS.
SMS_DRIVER=console
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=
AT_SANDBOX=true

# Firmware files for over-the-air updates (see README).
FIRMWARE_DIR=./firmware-releases

# Photos (resized and stripped of metadata on upload).
UPLOADS_DIR=./uploads
# The admin portal (Next.js). In production its https:// address.
ADMIN_ORIGIN=http://localhost:3000
# Ed25519 private key (PEM) that signs certificates. Required in production:
#   openssl genpkey -algorithm ed25519
CERT_SIGNING_KEY=

# MQTT: a second way for controllers to reach the platform. Off by default: HTTPS is the road in use.
# Switch it on later (more rooms, instant commands).
# The broker runs inside the API. Controllers sign in with their room id (HHR-001) and device token.
MQTT_ENABLED=false
MQTT_PORT=1883
# Over the internet use TLS: point these at a certificate and key and open port 8883.
# MQTT_TLS_CERT=/etc/ssl/harvest/fullchain.pem
# MQTT_TLS_KEY=/etc/ssl/harvest/privkey.pem
# MQTT_TLS_PORT=8883
# Production without TLS here is refused unless a TLS proxy in front ends the encryption: MQTT_ALLOW_PLAIN=true
