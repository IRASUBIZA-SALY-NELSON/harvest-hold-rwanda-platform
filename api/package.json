{
  "name": "harvest-hold-api",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/multipart": "^10.1.6",
    "@fastify/rate-limit": "^11.2.1",
    "@nestjs/common": "^12.3.2",
    "@nestjs/core": "^12.3.2",
    "@nestjs/platform-fastify": "^12.3.2",
    "aedes": "^1.2.0",
    "bcryptjs": "^3.0.3",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@swc/cli": "^0.8.2",
    "@swc/core": "^1.16.21",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "chokidar": "^5.0.0",
    "mqtt": "^5.16.1",
    "typescript": "^7.0.2",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.5"
  },
  "scripts": {
    "build": "swc src -d dist --strip-leading-paths",
    "dev": "swc src -d dist --strip-leading-paths --watch & sleep 3 && node --env-file=.env --enable-source-maps --watch dist/main.js",
    "start": "node --enable-source-maps dist/main.js",
    "migrate": "npm run build && node --env-file=.env dist/scripts/migrate.js",
    "seed": "npm run build && node --env-file=.env dist/scripts/seed.js",
    "simulate": "npm run build && node --env-file=.env dist/scripts/simulate.js",
    "firmware:release": "npm run build && node --env-file=.env dist/scripts/release-firmware.js",
    "admin:create": "npm run build && node --env-file=.env dist/scripts/create-admin.js",
    "admin:reset": "npm run build && node --env-file=.env dist/scripts/reset-admin.js",
    "typecheck": "tsc",
    "test": "vitest run"
  }
}
