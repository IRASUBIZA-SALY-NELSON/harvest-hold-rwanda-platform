# Copy to .env.production (never commit it) and fill in every value.
DB_PASSWORD=
# openssl rand -hex 32
SECRET=
# Public HTTPS addresses
PUBLIC_API_URL=https://api.harvesthold.rw
ADMIN_URL=https://admin.harvesthold.rw
# Signs certificates. Create it once and back it up; keep it secret. On one line:
#   openssl genpkey -algorithm ed25519 | awk 'BEGIN{ORS="\\n"}1'
CERT_SIGNING_KEY=
SMS_DRIVER=africastalking
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=
AT_SANDBOX=false

# MQTT for the controllers: OFF for now, HTTPS is in use. Switch it on later (more rooms): then put a
# TLS proxy on port 8883 that forwards to 127.0.0.1:1883 (nginx stream, Caddy layer4, HAProxy).
MQTT_ENABLED=false
MQTT_ALLOW_PLAIN=true
